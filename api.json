{
  "api": {
    "name": "CodeFolio GraphQL API",
    "endpoint": "/graphql",
    "protocol": "GraphQL",
    "description": "Single GraphQL endpoint for CodeFolio backend. All requests are POSTs to the `/graphql` endpoint with a JSON body: { \"query\": string, \"variables\": object }",
    "operations": [
      {
        "name": "users",
        "type": "query",
        "description": "Fetch all users",
        "exampleRequest": {
          "query": "query Users { users { _id nom prenom email image dateNaissance caver adress biographie createdAt updatedAt } }",
          "variables": {}
        },
        "exampleResponse": {
          "data": {
            "users": [
              {
                "_id": "60f5a3...",
                "nom": "Doe",
                "prenom": "John",
                "email": "john@example.com",
                "image": "https://...",
                "dateNaissance": "1990-01-01T00:00:00.000Z",
                "caver": "https://...",
                "adress": "123 Main St",
                "biographie": "...",
                "createdAt": "2024-01-01T00:00:00.000Z",
                "updatedAt": "2024-01-02T00:00:00.000Z"
              }
            ]
          },
          "errors": null
        }
      },
      {
        "name": "user",
        "type": "query",
        "description": "Fetch a single user by _id",
        "exampleRequest": {
          "query": "query User($id: ID!) { user(_id: $id) { _id nom prenom email } }",
          "variables": { "id": "60f5a3..." }
        },
        "exampleResponse": {
          "data": { "user": { "_id": "60f5a3...", "nom": "Doe", "prenom": "John", "email": "john@example.com" } },
          "errors": null
        }
      },
      {
        "name": "createUser",
        "type": "mutation",
        "description": "Create a new user (password will be hashed)",
        "exampleRequest": {
          "query": "mutation CreateUser($input: CreateUserInput!) { createUser(input: $input) { _id nom prenom email } }",
          "variables": { "input": { "nom": "Doe", "prenom": "John", "email": "john@example.com", "password": "s3cret" } }
        },
        "exampleResponse": {
          "data": { "createUser": { "_id": "60f5a3...", "nom": "Doe", "prenom": "John", "email": "john@example.com" } },
          "errors": null
        }
      },
      {
        "name": "updateUser",
        "type": "mutation",
        "description": "Update an existing user by _id",
        "exampleRequest": {
          "query": "mutation UpdateUser($id: ID!, $input: UpdateUserInput!) { updateUser(_id: $id, input: $input) { _id nom prenom email } }",
          "variables": { "id": "60f5a3...", "input": { "biographie": "New bio" } }
        },
        "exampleResponse": {
          "data": { "updateUser": { "_id": "60f5a3...", "nom": "Doe", "prenom": "John", "email": "john@example.com" } },
          "errors": null
        }
      },
      {
        "name": "deleteUser",
        "type": "mutation",
        "description": "Delete a user by _id; returns true on success",
        "exampleRequest": {
          "query": "mutation DeleteUser($id: ID!) { deleteUser(_id: $id) }",
          "variables": { "id": "60f5a3..." }
        },
        "exampleResponse": {
          "data": { "deleteUser": true },
          "errors": null
        }
      },

      {
        "name": "socials",
        "type": "query",
        "description": "List socials, optional filtered by userId",
        "exampleRequest": {
          "query": "query Socials($userId: ID) { socials(userId: $userId) { _id nom liensSociaux icon userId createdAt updatedAt } }",
          "variables": { "userId": null }
        },
        "exampleResponse": { "data": { "socials": [] }, "errors": null }
      },
      {
        "name": "social",
        "type": "query",
        "description": "Get a social by _id",
        "exampleRequest": { "query": "query Social($id: ID!) { social(_id: $id) { _id nom liensSociaux } }", "variables": { "id": "..." } },
        "exampleResponse": { "data": { "social": null }, "errors": null }
      },
      {
        "name": "createSocial",
